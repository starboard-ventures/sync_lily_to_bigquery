    {
      "job_cluster_key": "sync_lily_bigquery_cluster",
      "new_cluster": {
        "cluster_name": "",
        "spark_version": "15.4.x-scala2.12",
        "spark_conf": {
          "spark.databricks.io.cache.enabled": "true",
          "spark.hadoop.fs.gs.auth.service.account.private.key.id": "{{secrets/databricks-ext-bigquery/bigquery_private_key_id}}",
          "spark.databricks.delta.merge.enableLowShuffle": "true",
          "spark.hadoop.fs.gs.auth.service.account.private.key": "{{secrets/databricks-ext-bigquery/bigquery_private_key}}",
          "spark.executor.heartbeatInterval": "1500000",
          "spark.hadoop.google.cloud.auth.service.account.enable": "true",
          "spark.databricks.delta.properties.defaults.autoOptimize.optimizeWrite": "true",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.optimizer.dynamicFilePruning": "true",
          "spark.databricks.delta.autoCompact.enabled": "true",
          "spark.network.timeout": "10000000",
          "spark.sql.optimizer.dynamicPartitionPruning.enabled": "true",
          "spark.databricks.delta.properties.defaults.randomizeFilePrefixes": "true",
          "spark.hadoop.fs.gs.project.id": "lily-data",
          "spark.sql.adaptive.coalescePartitions.enabled": "true",
          "spark.shuffle.checksum.algorithm": "ADLER32",
          "spark.sql.execution.arrow.pyspark.enabled": "true",
          "spark.hadoop.fs.gs.auth.service.account.email": "{{secrets/databricks-ext-bigquery/bigquery_client_email}}",
          "spark.databricks.delta.optimizeWrite.numShuffleBlocks": "80000",
          "spark.shuffle.checksum.enabled": "true",
          "credentials": "{{secrets/databricks-ext-bigquery/bigquery_sa_json_base64}}",
          "spark.sql.shuffle.partitions": "auto"
